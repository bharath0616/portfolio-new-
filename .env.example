# Copy to `.env.local` and fill in. All values are optional for local development.

# Canonical origin. Used for metadataBase, canonical URLs, sitemap, robots and
# absolute Open Graph image URLs. Set this in production or social previews and
# canonical tags will point at the placeholder domain.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Resend API key for the contact form. https://resend.com/api-keys
# Without it the form still validates and accepts submissions, but nothing is
# delivered — the response reports `delivered: false` and the UI keeps the
# direct-email fallback visible.
RESEND_API_KEY=

# Verified sender for Resend. Must be a domain you have verified with them.
# Defaults to Resend's shared onboarding sender if unset.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
